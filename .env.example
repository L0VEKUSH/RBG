# Server
NODE_ENV=development
PORT=5000
# CORS & Allowed Frontend Origins (comma-separated origins; in production, FRONTEND_URL must match an allowed origin)
CORS_ORIGIN=http://localhost:5000,https://rbgschool.edu.in
RATE_LIMIT_MAX=100
# Distributed auth rate limiting. Required in production; leave unset for explicit
# local/test in-process fallback. Use a localhost Redis only for local testing.
REDIS_URL=redis://localhost:6379
TRUST_PROXY_HOPS=0
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_RECOVERY_RATE_LIMIT_MAX=5
AUTH_ACTIVATION_RATE_LIMIT_MAX=5
EMAIL_MAX_ATTEMPTS=5
EMAIL_BACKOFF_MS=1000
EMAIL_LEASE_MS=120000
EMAIL_RECONCILE_MS=30000
EMAIL_DELIVERY_RETENTION_MS=2592000000
EMAIL_ENCRYPTION_KEY_VERSION=v1
# Required in production: base64 for exactly 32 cryptographically random bytes.
# On rotation, set VERSION/KEY to the new key and PREVIOUS_VERSION/PREVIOUS to
# the old pair; retain the previous pair until old outbox records expire.
EMAIL_ENCRYPTION_KEY=
EMAIL_ENCRYPTION_KEY_PREVIOUS_VERSION=
EMAIL_ENCRYPTION_KEY_PREVIOUS=
EMAIL_QUEUE_PREFIX=erp-email:

# MongoDB
MONGO_URI=mongodb://localhost:27017/school_management_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email (Nodemailer) - Configure for password reset and notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Backwards-compatibility aliases:
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@rbgschool.edu.in
FROM_NAME=RBG School

# School Info & Frontend URL
# In production, FRONTEND_URL must use HTTPS and match an origin in CORS_ORIGIN
SCHOOL_NAME=RBG School
SCHOOL_ADDRESS=123 Education Lane, Model Town, New Delhi - 110001, India
SCHOOL_PHONE=+91-11-2345-6789
SCHOOL_EMAIL=info@rbgschool.edu.in
SCHOOL_WEBSITE=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# File Upload
MAX_FILE_UPLOAD=5242880
FILE_UPLOAD_PATH=./uploads
